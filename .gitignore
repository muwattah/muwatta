tessdata/
*.traineddata

# Logs and temp
*.log
integrity_scan/
integrity_run*.log
integrity_log.txt
/tmp/

# OS / editor
.DS_Store
.idea/
.vscode/
*.swp

# Old backups
app/viewer_old.py

# Durable runtime snapshots (never commit review DB)
storage/runtime/
storage/ocr_review/
